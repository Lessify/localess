{
  "name": "localess",
  "version": "4.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "pnpm --filter @localess/visual-editor-sync build && pnpm --parallel --filter @localess/server --filter @localess/web run dev",
    "start": "pnpm --filter @localess/visual-editor-sync build && pnpm --filter @localess/web start",
    "build": "pnpm --filter @localess/visual-editor-sync build && pnpm --filter @localess/web build",
    "build:prod": "pnpm --filter @localess/visual-editor-sync build && pnpm --filter @localess/web build:prod",
    "build:stats": "pnpm --filter @localess/visual-editor-sync build && pnpm --filter @localess/web build:stats",
    "watch": "pnpm --filter @localess/web watch",
    "test": "pnpm --filter @localess/visual-editor-sync build && pnpm --filter @localess/web test",
    "e2e": "pnpm build:prod && pnpm server:build && pnpm --filter @localess/e2e test",
    "e2e:run": "pnpm --filter @localess/e2e test",
    "e2e:smoke": "pnpm --filter @localess/e2e test:smoke",
    "e2e:ui": "pnpm --filter @localess/e2e test:ui",
    "e2e:install": "pnpm --filter @localess/e2e exec playwright install --with-deps chromium",
    "demos": "pnpm --filter @localess/e2e demos",
    "test:scripts": "node --test \"tools/scripts/**/*.test.mjs\" && pnpm --filter @localess/visual-editor-sync test",
    "lint": "pnpm --filter @localess/web --filter @localess/server lint",
    "lint:fix": "pnpm --filter @localess/web --filter @localess/server lint:fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "generate:github": "pnpm --filter @localess/web generate:github",
    "version:generate": "node tools/scripts/generate-version.js",
    "version:major": "node tools/scripts/bump-version.mjs major",
    "version:minor": "node tools/scripts/bump-version.mjs minor",
    "version:patch": "node tools/scripts/bump-version.mjs patch",
    "server:dev": "pnpm --filter @localess/server dev",
    "server:test": "pnpm --filter @localess/server test",
    "server:build": "pnpm --filter @localess/server build",
    "shared:build": "pnpm --filter @localess/shared build",
    "shared:test": "pnpm --filter @localess/shared test",
    "localess": "pnpm --filter @localess/server cli",
    "localess:check": "pnpm --filter @localess/server cli check"
  },
  "packageManager": "pnpm@12.10.1",
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:"
  }
}
