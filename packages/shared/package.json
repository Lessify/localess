{
  "name": "@localess/shared",
  "version": "4.1.0",
  "private": true,
  "description": "Domain contract shared by apps/server and apps/web: models, enums, permissions, locales, zod validators.",
  "type": "module",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "tsc -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
