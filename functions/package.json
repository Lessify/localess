{
  "name": "functions",
  "version": "4.0.0",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --fix --ext .js,.ts .",
    "prettier": "prettier --check ./src",
    "prettier:fix": "prettier --write ./src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "npm run build && firebase emulators:start --project demo-localess-dev --only functions",
    "shell": "npm run build && firebase functions:shell --project demo-localess-dev",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/translate": "^10.1.0",
    "archiver": "^7.0.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "deepl-node": "^1.28.0",
    "exiftool-vendored": "^38.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.35.4",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "openapi3-ts": "^4.6.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "private": true
}
