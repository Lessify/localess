# Localess server configuration: every environment variable the server reads, with its default.
# Copy to apps/server/.env for `pnpm dev` (that file is gitignored), or set them in Docker / Compose / your platform.
# Everything is optional: an empty install starts with an embedded Postgres and local storage in ./.data.
# Details and examples: docs/deployment/configuration.md

# --- Server --------------------------------------------------------------------------------------------------
# Listen port and address.
#PORT=3000
#HOST=0.0.0.0
# Public origin, e.g. https://cms.example.com. Used for OAuth callback URLs and password reset links.
# Set it whenever a proxy sits in front. Default: the request's origin.
#LOCALESS_PUBLIC_URL=
# The Angular build to serve. Default: apps/web/dist/browser in the checkout. Empty: serve the API only.
#LOCALESS_STATIC_DIR=
# Minimum log level: fatal, error, warn, log, debug, verbose (debug and up include the embedded Postgres log).
#LOCALESS_LOG_LEVEL=log

# --- Instance label ------------------------------------------------------------------------------------------
# Tells installations apart (for example production and test): shown in the sidebar and on the login page.
# Deployment configuration, so a database copied from production to test keeps the test label. Unset: no label.
#LOCALESS_INSTANCE_NAME=Test
# The label's color: primary, secondary, outline or destructive.
#LOCALESS_INSTANCE_COLOR=primary

# --- Database ------------------------------------------------------------------------------------------------
# External Postgres, e.g. postgres://user:pass@host:5432/localess. Unset: an embedded Postgres in LOCALESS_DATA_DIR.
#DATABASE_URL=
# Root of local state (the embedded cluster lives in $LOCALESS_DATA_DIR/pgdata). Default: .data in the repo root
# (/data in the Docker image).
#LOCALESS_DATA_DIR=
# Port of the embedded Postgres; it binds to 127.0.0.1 only.
#LOCALESS_EMBEDDED_PG_PORT=5433

# --- Storage -------------------------------------------------------------------------------------------------
# Asset originals, generated image renditions, task archives. Default: $LOCALESS_DATA_DIR/storage.
#LOCALESS_STORAGE_DIR=
# Largest asset or import upload, in MB; larger uploads get 413.
#LOCALESS_UPLOAD_MAX_MB=1024
# disk: keep generated image renditions next to the original; off: transform on every request, store nothing.
#LOCALESS_RENDITION_CACHE=disk
# ffmpeg binary for video thumbnails. Default: ffmpeg on the PATH.
#LOCALESS_FFMPEG_PATH=

# --- First admin ---------------------------------------------------------------------------------------------
# Create this admin (and the "Hello World" space) on boot while there are no users; ignored once any user exists.
# Password: at least 6 characters. `pnpm localess admin:create` also reads the password from here.
#LOCALESS_ADMIN_EMAIL=
#LOCALESS_ADMIN_PASSWORD=

# --- Sign-in -------------------------------------------------------------------------------------------------
# Text shown on the login page.
#LOCALESS_LOGIN_MESSAGE=
# Login and password-reset attempts per client IP per minute.
#LOCALESS_LOGIN_RATE_LIMIT=10
# OAuth providers to offer, comma-separated: GOOGLE, MICROSOFT.
#LOCALESS_AUTH_PROVIDERS=
# Google: the Workspace domain (verified on the returned token). Microsoft: the tenant (domain or tenant id),
# required for Microsoft.
#LOCALESS_AUTH_CUSTOM_DOMAIN=
# true: create an account (with no role) on the first OAuth sign-in of an unknown email.
#LOCALESS_AUTH_AUTO_REGISTER=false
# Google OAuth client.
#LOCALESS_GOOGLE_CLIENT_ID=
#LOCALESS_GOOGLE_CLIENT_SECRET=
# Google's OpenID issuer (only to point at another issuer, e.g. in tests).
#LOCALESS_GOOGLE_ISSUER=https://accounts.google.com
# Microsoft Entra ID app registration.
#LOCALESS_MICROSOFT_CLIENT_ID=
#LOCALESS_MICROSOFT_CLIENT_SECRET=
# Microsoft's OpenID issuer. Default: https://login.microsoftonline.com/<LOCALESS_AUTH_CUSTOM_DOMAIN>/v2.0
#LOCALESS_MICROSOFT_ISSUER=

# --- Email ---------------------------------------------------------------------------------------------------
# smtp://user:pass@host:587 or smtps://user:pass@host:465. Enables "forgot password" emails.
#LOCALESS_SMTP_URL=
# Sender address.
#LOCALESS_SMTP_FROM=Localess <no-reply@localhost>

# --- Machine translation -------------------------------------------------------------------------------------
# DeepL API key (takes precedence over Google).
#DEEPL_API_KEY=
# Google Cloud Translation in this project. Credentials via Application Default Credentials,
# e.g. GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account key.
#GOOGLE_CLOUD_PROJECT=
#LOCALESS_GOOGLE_TRANSLATE_LOCATION=global
# stub echoes the input back: development only.
#LOCALESS_TRANSLATE_PROVIDER=

# --- Plugins -------------------------------------------------------------------------------------------------
# Enables the Unsplash picker in Assets.
#UNSPLASH_API_KEY=
#LOCALESS_UNSPLASH_API_URL=https://api.unsplash.com

# --- Workers and webhooks ------------------------------------------------------------------------------------
# Run export/import/metadata tasks on this instance; false on API-only replicas.
#LOCALESS_TASK_WORKER=true
# Tasks one instance runs at once (1-16); imports hold their file's entries in memory. A space never runs two.
#LOCALESS_TASK_CONCURRENCY=1
# Let webhooks call loopback/private addresses. Local development only: it disables SSRF protection.
#LOCALESS_WEBHOOK_ALLOW_INTERNAL=false
# Days a webhook delivery log is kept; older ones are deleted every hour.
#LOCALESS_WEBHOOK_LOG_DAYS=30
# Test-only space templates (development and e2e; never in production). `pnpm dev` turns them on (dev.env).
#LOCALESS_TEST_TEMPLATES=false
