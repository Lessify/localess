{
  "name": "@localess/server",
  "version": "4.1.0",
  "private": true,
  "engines": {
    "node": "24"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -b ../../packages/shared && swc src -d dist-dev --strip-leading-paths --ignore \"**/*.test.ts\" -q && pnpm run \"/^dev:/\"",
    "dev:shared": "tsc -b ../../packages/shared --watch --preserveWatchOutput",
    "dev:swc": "swc src -d dist-dev --strip-leading-paths --ignore \"**/*.test.ts\" -q --watch",
    "dev:node": "node --watch --enable-source-maps --env-file-if-exists=.env dist-dev/main.js",
    "dev:types": "tsc -p tsconfig.build.json --noEmit --watch --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.5",
    "@google-cloud/translate": "^10.2.0",
    "@localess/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "archiver": "^7.0.1",
    "deepl-node": "^1.28.0",
    "drizzle-orm": "^0.45.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "exiftool-vendored": "^38.3.0",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "nodemailer": "^10.0.16",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "catalog:",
    "sharp": "^0.35.5",
    "unzipper": "^0.12.5",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/archiver": "^7.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "^0.10.11",
    "chokidar": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "ffmpeg-static": "^5.3.0",
    "oauth2-mock-server": "^9.2.0",
    "openapi3-ts": "^4.6.1",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "catalog:"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/darwin-arm64": true,
    "@embedded-postgres/windows-x64": true,
    "esbuild": true,
    "ffmpeg-static": true
  },
  "type": "module",
  "files": [
    "dist",
    "drizzle",
    "!dist/*.tsbuildinfo"
  ]
}
